  "assignmentId": "production-platform-action-handlers",
  "blockers": [
    {
      "description": "The current typed CHOOSE_DOCUMENT action always selects and imports an existing archive, while create-backup and export require a destination-document contract. AndroidSystemPickerHost and NativePlatformServices already expose destination pickers, but the shared typed action does not distinguish import from destination selection; therefore this handoff does not claim QG-012 snapshot-roundtrip-test or file-integration-test coverage.",
      "nextAction": "Add a separately assigned typed destination-document action and route create-backup/export to the existing Android/iOS destination pickers, then run the declared QG-012 snapshot-roundtrip-test and file-integration-test surfaces.",
      "obligationIds": [
        "QG-012"
      ]
    }
  ],
