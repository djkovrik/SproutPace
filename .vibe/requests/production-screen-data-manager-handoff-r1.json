  "blockers": [
    {
      "description": "The production root currently depends on :shared:component but not :shared:data, so ProductionScreenDataManager is not yet constructed or injected into ScreenComponentDependencies.",
      "nextAction": "Create a root-owned assembly assignment that adds the data dependency, platform driver/settings factories and injects this manager instead of EmptyScreenDataManager.",
      "obligationIds": [
        "AC-010",
        "AC-020",
        "AC-030",
        "AC-050",
        "AC-060",
        "AC-080"
      ]
    },
    {
      "description": "AC-032 full correction semantics and AC-039 reminder rebuilding cannot be completed from current contracts: no domain operation recalculates dependent future actions after arbitrary correction, and undoLastTransition requires a prebuilt action list but no schedule builder contract exists. This manager preserves past events and supports typed mass/place correction, while passing the existing action set to undo.",
      "nextAction": "Add a domain-owned deterministic action rebuilding/correction engine, then extend the manager in a separately registered assignment.",
      "obligationIds": [
        "AC-032",
        "AC-039"
      ]
    },
    {
      "description": "HarvestPlan does not persist a first-harvest anchor or generated suggestion state. Suggestions are therefore deterministically recomputed from the injected current local date, but a user-selected anchor cannot be restored under the present model.",
      "nextAction": "Decide in Domain whether the anchor is plan data; if yes, add it with a persistence migration before claiming full restart semantics.",
      "obligationIds": [
        "AC-051",
        "AC-052",
        "AC-057"
      ]
    },
    {
      "description": "The data manager stores stable soak/civil action identities and preserves elapsed targets across time-zone changes, but native reminder scheduling/reconciliation is outside the allowed data files and still needs the required platform-test surfaces.",
      "nextAction": "Wire persisted actions to the platform ReminderManager and run platform tests in the platform/root integration assignment.",
      "obligationIds": [
        "AC-066",
        "AC-068"
      ]
    },
    {
      "description": "Destructive ACs outside this assignment cannot safely mutate through the current root confirmation because ConfirmationComponent only dismisses and ScreenStore emits Completed after manager execution; post-hoc confirmation would violate confirmation-before-mutation.",
      "nextAction": "Introduce a non-mutating request-confirmation output and a distinct confirmed command before implementing delete/reset operations.",
      "obligationIds": []
    },
    {
      "description": "Gradle execution is reserved for the orchestrator, so compilation and the new real-schema tests remain requested rather than claimed.",
      "nextAction": "Run the requested Android host tests plus Android/iOS compilation and inspect any failures before ingestion.",
      "obligationIds": [
        "QG-011"
      ]
    }
  ]
