CREATE TABLE grow_zone (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL CHECK (length(trim(name)) > 0),
  type TEXT NOT NULL CHECK (type IN ('NATURAL_LIGHT','GROW_LIGHT','DARK')),
  capacity INTEGER NOT NULL CHECK (capacity >= 0),
  sort_order INTEGER NOT NULL CHECK (sort_order >= 0)
);
CREATE UNIQUE INDEX grow_zone_order ON grow_zone(sort_order, id);

CREATE TABLE tray_preset (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL CHECK (length(trim(name)) > 0),
  shape TEXT NOT NULL CHECK (shape IN ('RECTANGLE','CIRCLE')),
  primary_cm REAL NOT NULL CHECK (primary_cm > 0),
  secondary_cm REAL CHECK (secondary_cm IS NULL OR secondary_cm > 0),
  sort_order INTEGER NOT NULL CHECK (sort_order >= 0)
);
CREATE UNIQUE INDEX tray_preset_order ON tray_preset(sort_order, id);

CREATE TABLE user_recipe (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL CHECK (length(trim(name)) > 0),
  culture_id TEXT,
  payload TEXT NOT NULL,
  sort_order INTEGER NOT NULL CHECK (sort_order >= 0)
);
CREATE INDEX user_recipe_culture ON user_recipe(culture_id);

CREATE TABLE grow_batch (
  id TEXT NOT NULL PRIMARY KEY,
  state TEXT NOT NULL,
  source_recipe_id TEXT,
  built_in_culture_id TEXT,
  payload TEXT NOT NULL,
  sort_order INTEGER NOT NULL CHECK (sort_order >= 0)
);
CREATE INDEX grow_batch_state_order ON grow_batch(state, sort_order, id);

CREATE TABLE harvest_plan (
  id TEXT NOT NULL PRIMARY KEY,
  payload TEXT NOT NULL,
  sort_order INTEGER NOT NULL CHECK (sort_order >= 0)
);

CREATE TABLE observation (
  id TEXT NOT NULL PRIMARY KEY,
  batch_id TEXT NOT NULL REFERENCES grow_batch(id) ON DELETE CASCADE,
  occurred_at TEXT NOT NULL,
  photo_id TEXT UNIQUE,
  payload TEXT NOT NULL
);
CREATE INDEX observation_batch_time ON observation(batch_id, occurred_at, id);

selectZones:
SELECT * FROM grow_zone ORDER BY sort_order, id;
upsertZone {
INSERT INTO grow_zone(id,name,type,capacity,sort_order)
SELECT :id,:name,:type,:capacity,:sort_order WHERE 0;
UPDATE grow_zone SET name=:name,type=:type,capacity=:capacity,sort_order=:sort_order WHERE id=:id;
INSERT INTO grow_zone(id,name,type,capacity,sort_order)
SELECT :id,:name,:type,:capacity,:sort_order WHERE changes() = 0;
}
deleteZone:
DELETE FROM grow_zone WHERE id = ?;

selectTrayPresets:
SELECT * FROM tray_preset ORDER BY sort_order, id;
upsertTrayPreset {
INSERT INTO tray_preset(id,name,shape,primary_cm,secondary_cm,sort_order)
SELECT :id,:name,:shape,:primary_cm,:secondary_cm,:sort_order WHERE 0;
UPDATE tray_preset SET name=:name,shape=:shape,primary_cm=:primary_cm,
  secondary_cm=:secondary_cm,sort_order=:sort_order WHERE id=:id;
INSERT INTO tray_preset(id,name,shape,primary_cm,secondary_cm,sort_order)
SELECT :id,:name,:shape,:primary_cm,:secondary_cm,:sort_order WHERE changes() = 0;
}
deleteTrayPreset:
DELETE FROM tray_preset WHERE id = ?;

