SELECT payload FROM harvest_plan ORDER BY sort_order, id;
upsertPlan {
INSERT INTO harvest_plan(id,payload,sort_order) SELECT :id,:payload,:sort_order WHERE 0;
UPDATE harvest_plan SET payload=:payload,sort_order=:sort_order WHERE id=:id;
INSERT INTO harvest_plan(id,payload,sort_order) SELECT :id,:payload,:sort_order WHERE changes() = 0;
}
