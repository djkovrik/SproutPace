selectObservations:
SELECT payload FROM observation ORDER BY occurred_at, id;
selectObservationsForBatch:
SELECT payload FROM observation WHERE batch_id = ? ORDER BY occurred_at, id;
upsertObservation {
INSERT INTO observation(id,batch_id,occurred_at,photo_id,payload)
SELECT :id,:batch_id,:occurred_at,:photo_id,:payload WHERE 0;
UPDATE observation SET batch_id=:batch_id,occurred_at=:occurred_at,
  photo_id=:photo_id,payload=:payload WHERE id=:id;
INSERT INTO observation(id,batch_id,occurred_at,photo_id,payload)
SELECT :id,:batch_id,:occurred_at,:photo_id,:payload WHERE changes() = 0;
}
deleteObservation:
DELETE FROM observation WHERE id = ?;

deleteAllObservations:
DELETE FROM observation;
deleteAllPlans:
DELETE FROM harvest_plan;
deleteAllBatches:
DELETE FROM grow_batch;
deleteAllRecipes:
DELETE FROM user_recipe;
deleteAllTrayPresets:
DELETE FROM tray_preset;
deleteAllZones:
DELETE FROM grow_zone;
